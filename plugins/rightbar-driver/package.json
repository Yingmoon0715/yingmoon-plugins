{
  "name": "rightbar-driver",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "description": "Drive the built-in browser inside the DSH right sidebar (35 tools), serve web_search from a self-hosted SearXNG (17 engines), and fetch pages through a mirror-fallback provider so blocked GitHub links still load.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yingmoon0715/yingmoon-plugins.git",
    "directory": "plugins/rightbar-driver"
  },
  "homepage": "https://github.com/Yingmoon0715/yingmoon-plugins/tree/main/plugins/rightbar-driver",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-0 <5.0.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0-0 <4.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
