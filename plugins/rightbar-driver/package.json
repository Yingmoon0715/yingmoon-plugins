{
  "name": "@local/rightbar-driver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drive the built-in browser inside the DSH right sidebar: open, navigate, read, click, fill, close.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yingmoon/rightbar-driver.git"
  },
  "homepage": "https://github.com/yingmoon/rightbar-driver",
  "license": "MIT",
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "README.md"],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-0 <5.0.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0-0 <4.0.0-0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
